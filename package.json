{
  "name": "ancient-persia-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first Persian strategy board game built with Phaser 4 and TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.71.2",
    "vite": "^6.4.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
